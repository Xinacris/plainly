# Copy to .env.local (the app) and, for the test project, .env.test.local.
# Both are gitignored. Never commit real values.

# --- .env.local: what the browser gets (public by design; RLS protects the data) ---
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# --- .env.test.local: a separate Supabase project for verification ---
# The VITE_ pair above, pointed at the test project (used by `vite build --mode test`), plus:
# SUPABASE_TEST_SECRET_KEY="sb_secret_..."   # verify.mjs and rls-test.mjs create and delete test users
# SUPABASE_ACCESS_TOKEN="sbp_..."            # Supabase CLI: link and push migrations
# SUPABASE_DB_PASSWORD_PROD="..."            # Supabase CLI: production database
# SUPABASE_DB_PASSWORD_TEST="..."            # Supabase CLI: test database
